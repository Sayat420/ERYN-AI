# ERYN environment configuration
# Copy this file to .env and replace values with your own keys.

# Choose one of: openai, anthropic, google, github, local
AI_BACKEND=github

# Your API key for the chosen backend
AI_API_KEY=sk-your-api-key-here

# Optional model settings
AI_OPENAI_MODEL=gpt-4o
AI_ANTHROPIC_MODEL=claude-3.5
AI_GOOGLE_MODEL=gemini-pro

# Optional temperature settings
AI_OPENAI_TEMPERATURE=0.7
AI_ANTHROPIC_TEMPERATURE=0.7
AI_GOOGLE_TEMPERATURE=0.7
